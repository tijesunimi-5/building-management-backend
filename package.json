{
  "name": "prop-mgt-backend",
  "version": "1.0.0",
  "description": "REST API backend for ApexCare Property Maintenance SaaS Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "server": "node dist/server.js",
    "db:init": "ts-node -e \"import { initDb } from './src/db/init'; initDb().then(() => process.exit(0));\"",
    "db:clear": "ts-node src/db/clear.ts"
  },
  "keywords": [
    "property-management",
    "express",
    "typescript",
    "rest-api"
  ],
  "author": "ApexCare Team",
  "license": "ISC",
  "dependencies": {
    "@types/pg": "^8.23.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
